Subject: [PATCH] Show whole head, seat Pearl on a cushion

---
 src/App.tsx   | 11 +++++++----
 src/index.css |  8 ++++----
 2 files changed, 11 insertions(+), 8 deletions(-)

diff --git a/src/App.tsx b/src/App.tsx
index 884d015..72e762b 100644
--- a/src/App.tsx
+++ b/src/App.tsx
@@ -73,9 +73,11 @@ function Chair({ layer }: { layer: 'back' | 'front' }) {
         </>
       ) : (
         <>
-          <rect x="40" y="318" width="320" height="112" rx="40" fill={`url(#${id})`} stroke="#5c121c" strokeWidth="6" />
-          <rect x="3" y="196" width="96" height="214" rx="44" fill={`url(#${id})`} stroke="#5c121c" strokeWidth="6" />
-          <rect x="301" y="196" width="96" height="214" rx="44" fill={`url(#${id})`} stroke="#5c121c" strokeWidth="6" />
+          <rect x="40" y="346" width="320" height="96" rx="34" fill={`url(#${id})`} stroke="#5c121c" strokeWidth="6" />
+          <rect x="30" y="298" width="340" height="76" rx="36" fill={`url(#${id})`} stroke="#5c121c" strokeWidth="6" />
+          <rect x="48" y="306" width="304" height="22" rx="11" fill="#fff" opacity=".1" />
+          <rect x="3" y="196" width="96" height="222" rx="44" fill={`url(#${id})`} stroke="#5c121c" strokeWidth="6" />
+          <rect x="301" y="196" width="96" height="222" rx="44" fill={`url(#${id})`} stroke="#5c121c" strokeWidth="6" />
         </>
       )}
     </svg>
@@ -92,7 +94,8 @@ function Body() {
         <radialGradient id="pad-g" cx=".4" cy=".3" r=".8"><stop offset="0" stopColor="#9a7a83"/><stop offset="1" stopColor="#64484f"/></radialGradient>
         <pattern id="fur-p" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M1 8 l2 -5 M6 9 l2 -5 M3.5 4 l1 -3 M8 4 l1.5 -3" stroke="#8f6a38" strokeOpacity=".45" strokeWidth="1.3" strokeLinecap="round" fill="none"/></pattern>
       </defs>
-      <g stroke="#85612f" strokeWidth="3" strokeLinejoin="round" strokeLinecap="round">
+      <ellipse cx="200" cy="360" rx="112" ry="14" fill="#2a0a10" opacity=".35" />
+      <g transform="translate(0 -30)" stroke="#85612f" strokeWidth="3" strokeLinejoin="round" strokeLinecap="round">
         <path d="M118 300 Q110 236 200 232 Q290 236 282 300 Q298 380 262 404 Q200 424 138 404 Q102 380 118 300Z" fill="url(#fur-g)"/>
         <path d="M118 300 Q110 236 200 232 Q290 236 282 300 Q298 380 262 404 Q200 424 138 404 Q102 380 118 300Z" fill="url(#fur-p)" stroke="none"/>
         <ellipse cx="200" cy="338" rx="54" ry="64" fill="url(#belly-g)" stroke="none"/><ellipse cx="200" cy="338" rx="54" ry="64" fill="url(#fur-p)" stroke="none" opacity=".6"/>
diff --git a/src/index.css b/src/index.css
index 1564744..950293e 100644
--- a/src/index.css
+++ b/src/index.css
@@ -50,13 +50,13 @@ button { font: inherit; }
 /* Only Pearl's head is shown: --hx/--hy = head centre and --hs = head width, as fractions of each photo. */
 .pearl {
   --hx: .49; --hy: .4; --hs: .6;
-  position: absolute; z-index: 5; left: 22.7%; top: 17%; width: 54.5%; aspect-ratio: 1; overflow: hidden;
+  position: absolute; z-index: 5; left: 20%; top: 14.6%; width: 60%; aspect-ratio: 1; overflow: hidden;
   transform-origin: 50% 100%; transition: transform .3s;
-  -webkit-mask-image: radial-gradient(closest-side, #000 80%, transparent 100%); mask-image: radial-gradient(closest-side, #000 80%, transparent 100%);
+  -webkit-mask-image: radial-gradient(closest-side, #000 86%, transparent 100%); mask-image: radial-gradient(closest-side, #000 86%, transparent 100%);
 }
 .pearl img {
-  position: absolute; max-width: none; height: auto; width: calc(86% / var(--hs));
-  left: calc(50% - var(--hx) * 86% / var(--hs)); top: calc(50% - var(--hy) * 86% / var(--hs));
+  position: absolute; max-width: none; height: auto; width: calc(64% / var(--hs));
+  left: calc(50% - var(--hx) * 64% / var(--hs)); top: calc(50% - var(--hy) * 64% / var(--hs));
 }
 .pearl.react-laugh { --hx: .54; --hy: .34; --hs: .44; }
 .pearl.react-groan { --hx: .51; --hy: .44; --hs: .68; }
